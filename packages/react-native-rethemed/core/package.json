{
  "name": "@react-native-rethemed/core",
  "version": "0.1.1",
  "description": "Type-safe design tokens for React Native style props — light/dark themes, text presets, and a themed style API.",
  "keywords": [
    "react-native",
    "react-native-rethemed",
    "design-tokens",
    "theme",
    "dark-mode",
    "typescript"
  ],
  "license": "MIT",
  "author": "manakuro",
  "homepage": "https://github.com/manakuro/react-native-rethemed/tree/main/packages/react-native-rethemed/core#readme",
  "bugs": {
    "url": "https://github.com/manakuro/react-native-rethemed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manakuro/react-native-rethemed.git",
    "directory": "packages/react-native-rethemed/core"
  },
  "sideEffects": false,
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "lint": "biome check src",
    "lint:fix": "biome check --write --unsafe src",
    "tsc": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.cts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./config": {
        "import": "./dist/config.mjs",
        "require": "./dist/config.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": "*"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.5.4",
    "@types/react": "19.2.17",
    "biome-config": "workspace:*",
    "publint": "0.3.25",
    "react": "catalog:",
    "react-native": "catalog:",
    "tsdown": "0.23.0",
    "tsdown-config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
