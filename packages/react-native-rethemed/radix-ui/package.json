{
  "name": "@react-native-rethemed/radix-ui-tokens",
  "version": "0.1.0",
  "description": "Radix UI Themes tokens (Radix Colors scales, typography, radii, shadows) for React Native, ready for react-native-rethemed.",
  "keywords": [
    "react-native",
    "react-native-rethemed",
    "radix-ui",
    "radix-colors",
    "design-tokens"
  ],
  "license": "MIT",
  "author": "manakuro",
  "homepage": "https://github.com/manakuro/react-native-rethemed/tree/main/packages/react-native-rethemed/radix-ui#readme",
  "bugs": {
    "url": "https://github.com/manakuro/react-native-rethemed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manakuro/react-native-rethemed.git",
    "directory": "packages/react-native-rethemed/radix-ui"
  },
  "sideEffects": false,
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "generate": "jiti scripts/generate.ts",
    "example:codegen": "react-native-rethemed codegen example/theme.ts --docs example/themed.md",
    "lint": "biome check src scripts example",
    "lint:fix": "biome check --write --unsafe src scripts example",
    "tsc": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.cts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@react-native-rethemed/core": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.5.4",
    "@radix-ui/themes": "3.3.0",
    "@react-native-rethemed/cli": "workspace:*",
    "@types/culori": "4.0.1",
    "@types/node": "24.10.4",
    "@types/react": "19.2.17",
    "biome-config": "workspace:*",
    "culori": "4.0.2",
    "jiti": "2.7.0",
    "publint": "0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "tsdown": "0.23.0",
    "tsdown-config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
