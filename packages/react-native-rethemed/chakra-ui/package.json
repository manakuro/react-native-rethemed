{
  "name": "@react-native-rethemed/chakra-ui-tokens",
  "version": "0.1.0",
  "description": "Chakra UI's default design tokens for React Native, ready for react-native-rethemed.",
  "keywords": [
    "react-native",
    "react-native-rethemed",
    "chakra-ui",
    "design-tokens"
  ],
  "license": "MIT",
  "author": "manakuro",
  "homepage": "https://github.com/manakuro/react-native-rethemed/tree/main/packages/react-native-rethemed/chakra-ui#readme",
  "bugs": {
    "url": "https://github.com/manakuro/react-native-rethemed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manakuro/react-native-rethemed.git",
    "directory": "packages/react-native-rethemed/chakra-ui"
  },
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-package.mjs",
    "prepack": "pnpm run build",
    "example:codegen": "react-native-rethemed codegen example/theme.ts --docs example/themed.md",
    "lint": "biome check src example",
    "lint:fix": "biome check --write --unsafe src example",
    "tsc": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/cjs/index.js",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@react-native-rethemed/core": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@react-native-rethemed/cli": "workspace:*",
    "@types/node": "24.10.4",
    "@types/react": "19.2.17",
    "biome-config": "workspace:*",
    "react": "catalog:",
    "react-native": "catalog:",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
