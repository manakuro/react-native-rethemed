{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // Workspace packages (`@react-native-rethemed/*`) have their own react /
    // react-native devDependencies. Type-check them against the app's copies
    // (same as the singleton resolution in metro.config.js).
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
